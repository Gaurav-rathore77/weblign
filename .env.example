# MongoDB Atlas connection string (server-only; never expose as NEXT_PUBLIC_*)
MONGODB_URI=
MONGODB_DB=weblign

# Use a long random value, for example: openssl rand -base64 32
AUTH_SECRET=

# Initial admin login. Either set a hash:
#   npm run admin:hash -- "your-password"
# or seed a MongoDB admin account with:
#   npm run admin:seed -- admin@example.com "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Optional local-development-only fallback. Do not use in production.
ADMIN_PASSWORD=

# Email notifications for new contact inquiries (Gmail SMTP example)
# Use a Gmail App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info.weblign@gmail.com
SMTP_PASSWORD=
CONTACT_FROM_EMAIL="Weblign <info.weblign@gmail.com>"
CONTACT_TO_EMAIL=info.weblign@gmail.com

# Optional AI guide provider. Without these, the built-in Weblign guide still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public site URL
NEXT_PUBLIC_SITE_URL=https://www.weblign.in

# ImageKit CDN (public delivery only — these two are safe to expose).
# The ImageKit PRIVATE key must never be committed or sent to the browser.
NEXT_PUBLIC_IMAGEKIT_URL=https://ik.imagekit.io/uzfbs5ap1
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_ttEPqPHihKn6koKCNjCX1S8ZGB0=
# Server-only. Used by scripts/upload-to-imagekit.mjs. Keep it in your local
# .env.local and in the deployment platform's secret settings, never in git.
IMAGEKIT_PRIVATE_KEY=
